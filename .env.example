# Copy to .env and fill in. run.sh sources it automatically.
#   cp .env.example .env

# --- Required ---------------------------------------------------------------

# Your Cube Cloud deployment. Either the bare host or the full API path works.
CUBE_API_URL=https://your-deployment.cubecloudapp.dev

# API token. For a quick start, copy the token your deployment's Playground is
# using (browser devtools -> any /v1/load request -> Authorization header).
# For anything longer-lived, sign a JWT with your deployment's API secret.
# NEVER commit a real token -- .env is gitignored for this reason.
CUBE_API_TOKEN=

# --- Load shape (per-script; also settable inline, e.g. RPS=50 ./run.sh ...) -

RPS=10
DURATION=1m
QUERY=aggregate

# --- Query tuning (see queries.js) -----------------------------------------

ENTITY_KEY_MAX=10000
LOOKBACK_MIN_DAYS=7
LOOKBACK_MAX_DAYS=90

# Traffic mix for mixed-workload.js
WEIGHT_AGGREGATE=70
WEIGHT_DRILLDOWN=25
WEIGHT_RAWPAGE=5

# --- Behaviour -------------------------------------------------------------

# true = add renewQuery to every request, bypassing Cube's result cache.
# Measures worst-case cost instead of what users typically experience.
RENEW_QUERY=false

# Give up on a single query after this long (across all Continue-wait polls).
QUERY_TIMEOUT_MS=120000

# Gap between Continue-wait polls. 1000 matches Cube's own JS client.
POLL_INTERVAL_MS=1000
